{
  "name": "ComplianceAuditLog",
  "type": "object",
  "properties": {
    "club_id": {
      "type": "string"
    },
    "record_id": {
      "type": "string",
      "description": "ComplianceRecord id"
    },
    "coach_email": {
      "type": "string"
    },
    "requirement_type": {
      "type": "string"
    },
    "season_name": {
      "type": "string"
    },
    "old_status": {
      "type": "string"
    },
    "new_status": {
      "type": "string"
    },
    "changed_by": {
      "type": "string",
      "description": "Email of the person, or 'system' for automated rules"
    },
    "changed_at": {
      "type": "string",
      "format": "date-time"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "club_id",
    "record_id",
    "new_status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.club_id": "{{user.data.club_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}