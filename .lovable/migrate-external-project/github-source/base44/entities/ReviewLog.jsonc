{
  "name": "ReviewLog",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string"
    },
    "club_id": {
      "type": "string"
    },
    "actor": {
      "type": "string"
    },
    "action": {
      "type": "string"
    },
    "detail": {
      "type": "string",
      "description": "What changed. Never contains personal data."
    }
  },
  "required": [
    "project_id",
    "club_id",
    "actor",
    "action"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.club_id": "{{user.data.club_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}