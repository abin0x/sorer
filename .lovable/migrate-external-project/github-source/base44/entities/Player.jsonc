{
  "name": "Player",
  "type": "object",
  "properties": {
    "club_id": {
      "type": "string",
      "description": "ID of the Club (tenant) this player belongs to"
    },
    "unique_id": {
      "type": "string",
      "description": "Unique identifier for the player (used for imports/updates)"
    },
    "first_name": {
      "type": "string",
      "description": "Player first name"
    },
    "last_name": {
      "type": "string",
      "description": "Player last name"
    },
    "date_of_birth": {
      "type": "string",
      "format": "date",
      "description": "Player date of birth"
    },
    "gender": {
      "type": "string",
      "enum": [
        "Boys",
        "Girls"
      ],
      "description": "Gender eligibility"
    },
    "guardian_id": {
      "type": "string",
      "description": "ID of the primary guardian (Guardian entity) \u2014 used for default display/contact"
    },
    "guardian_name": {
      "type": "string",
      "description": "Primary guardian full name (denormalized for display)"
    },
    "guardian_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "IDs of all guardians linked to this player (supports multiple parents/guardians per player)"
    },
    "location_id": {
      "type": "string",
      "description": "ID of the primary Location this player is registered at"
    },
    "location_name": {
      "type": "string",
      "description": "Location name (denormalized for display)"
    },
    "team_id": {
      "type": "string",
      "description": "ID of the assigned team (Team entity, optional)"
    },
    "team_name": {
      "type": "string",
      "description": "Assigned team name (denormalized for display)"
    },
    "age_group": {
      "type": "string",
      "description": "Age group, denormalized from the assigned Team (e.g. U14)"
    },
    "league": {
      "type": "string",
      "description": "League, denormalized from the assigned Team (e.g. MSPRL, NPL, ECNL)"
    },
    "coach_id": {
      "type": "string",
      "description": "ID of the head coach, denormalized from the assigned Team"
    },
    "coach_name": {
      "type": "string",
      "description": "Head coach name, denormalized from the assigned Team"
    },
    "program_id": {
      "type": "string",
      "description": "ID of the program the player registered for (Program entity)"
    },
    "program_title": {
      "type": "string",
      "description": "Program title (denormalized for display)"
    },
    "season": {
      "type": "string",
      "description": "Season the player is registered for (e.g. 2026-2027)",
      "default": "2026-2027"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive",
        "waitlist",
        "pending"
      ],
      "default": "pending",
      "description": "Player enrollment status"
    },
    "position": {
      "type": "string",
      "enum": [
        "1 - Goalkeeper",
        "2 - Right Back",
        "3 - Left Back",
        "4 - Right Centerback",
        "5 - Left Centerback",
        "6 - Holding Midfielder",
        "7 - Right Winger",
        "8 - Center Midfielder",
        "9 - Center Forward",
        "10 - Attacking Midfielder",
        "11 - Left Midfielder"
      ],
      "description": "Preferred playing position (standard 1-11 numbering)"
    },
    "jersey_number": {
      "type": "string",
      "description": "Assigned jersey number"
    },
    "photo_url": {
      "type": "string",
      "description": "URL to player photo"
    },
    "medical_notes": {
      "type": "string",
      "description": "Medical conditions or allergies (permission-controlled)"
    },
    "notes": {
      "type": "string",
      "description": "Internal notes about the player"
    },
    "source": {
      "type": "string",
      "description": "Where this record came from (e.g. migration)"
    },
    "migration_batch_id": {
      "type": "string",
      "description": "Migration commit batch that created or last updated this record"
    }
  },
  "required": [
    "first_name",
    "last_name",
    "date_of_birth",
    "guardian_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.club_id": "{{user.data.club_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.club_id": "{{user.data.club_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.club_id": "{{user.data.club_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.club_id": "{{user.data.club_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}