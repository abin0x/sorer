{
  "name": "Coach",
  "type": "object",
  "properties": {
    "club_id": {
      "type": "string",
      "description": "ID of the Club (tenant) this coach belongs to"
    },
    "unique_id": {
      "type": "string",
      "description": "Unique identifier for the coach (used for imports/updates)"
    },
    "first_name": {
      "type": "string",
      "description": "Coach first name"
    },
    "last_name": {
      "type": "string",
      "description": "Coach last name"
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "Coach email address"
    },
    "phone": {
      "type": "string",
      "description": "Coach phone number"
    },
    "role": {
      "type": "string",
      "enum": [
        "head_coach",
        "assistant_coach",
        "trainer",
        "admin",
        "volunteer"
      ],
      "default": "head_coach",
      "description": "Coaching role"
    },
    "location_id": {
      "type": "string",
      "description": "ID of the primary Location this coach is based at"
    },
    "location_name": {
      "type": "string",
      "description": "Location name (denormalized for display)"
    },
    "team_id": {
      "type": "string",
      "description": "ID of the primary team assignment (Team entity)"
    },
    "team_name": {
      "type": "string",
      "description": "Assigned team name (denormalized for display)"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive"
      ],
      "default": "active",
      "description": "Coach status"
    },
    "notes": {
      "type": "string",
      "description": "Internal notes about the coach"
    }
  },
  "required": [
    "first_name",
    "last_name",
    "email"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.club_id": "{{user.data.club_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.club_id": "{{user.data.club_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.club_id": "{{user.data.club_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.club_id": "{{user.data.club_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}