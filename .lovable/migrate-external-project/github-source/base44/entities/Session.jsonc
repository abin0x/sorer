{
  "name": "Session",
  "type": "object",
  "properties": {
    "club_id": {
      "type": "string",
      "description": "ID of the Club (tenant) this session belongs to"
    },
    "occurrence_id": {
      "type": "string",
      "description": "ID of the EventOccurrence this session happens on"
    },
    "name": {
      "type": "string",
      "description": "Session name"
    },
    "start_time": {
      "type": "string",
      "description": "Start time (HH:MM, 24h, in the occurrence's timezone)"
    },
    "end_time": {
      "type": "string",
      "description": "End time (HH:MM, 24h)"
    },
    "location_id": {
      "type": "string",
      "description": "ID of the EventLocation"
    },
    "field_id": {
      "type": "string",
      "description": "ID of the EventField"
    },
    "capacity": {
      "type": "number",
      "default": 0,
      "description": "Maximum capacity for this session"
    },
    "status": {
      "type": "string",
      "enum": [
        "scheduled",
        "cancelled"
      ],
      "default": "scheduled",
      "description": "Session status"
    },
    "notes": {
      "type": "string",
      "description": "Notes about this session"
    }
  },
  "required": [
    "club_id",
    "occurrence_id",
    "name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.club_id": "{{user.data.club_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.club_id": "{{user.data.club_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.club_id": "{{user.data.club_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.club_id": "{{user.data.club_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}