{
  "name": "TryoutTask",
  "type": "object",
  "properties": {
    "club_id": {
      "type": "string",
      "description": "ID of the Club (tenant) this task belongs to"
    },
    "tryout_event_id": {
      "type": "string",
      "description": "ID of the TryoutEvent this parent task was auto-generated for"
    },
    "title": {
      "type": "string",
      "description": "Task title (e.g. 'Tryout \u2014 U14 \u2014 2027-03-14')"
    },
    "due_date": {
      "type": "string",
      "format": "date",
      "description": "Task due date (defaults to 1 day before the event)"
    },
    "assignee_id": {
      "type": "string",
      "description": "ID of the assigned user (defaults to the plan's Tryout Lead)"
    },
    "assignee_name": {
      "type": "string",
      "description": "Assignee name (denormalized for display)"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "in_progress",
        "completed"
      ],
      "default": "pending",
      "description": "Task status"
    },
    "progress": {
      "type": "number",
      "default": 0,
      "description": "Percentage of subtasks completed (0-100), recalculated as subtasks change"
    }
  },
  "required": [
    "tryout_event_id",
    "title"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.club_id": "{{user.data.club_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.club_id": "{{user.data.club_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.club_id": "{{user.data.club_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.club_id": "{{user.data.club_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}