{
  "name": "CommitBatch",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string"
    },
    "club_id": {
      "type": "string"
    },
    "entity": {
      "type": "string"
    },
    "created_ids": {
      "type": "array",
      "default": [],
      "items": {
        "type": "string"
      }
    },
    "updated": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "prior": {
            "type": "object"
          }
        }
      },
      "description": "Updated live records with the values they had before"
    },
    "status": {
      "type": "string",
      "enum": [
        "committing",
        "done",
        "rolled_back"
      ],
      "default": "committing"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "project_id",
    "club_id",
    "entity"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.club_id": "{{user.data.club_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}