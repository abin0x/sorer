{
  "name": "TrialSignups",
  "type": "object",
  "properties": {
    "email": {
      "type": "string",
      "format": "email",
      "description": "Email address of the trial signup"
    },
    "user_id": {
      "type": "string",
      "description": "ID of the User who started the trial (set after Google signup)"
    },
    "club_id": {
      "type": "string",
      "description": "ID of the Club created for this trial"
    },
    "club_name": {
      "type": "string",
      "description": "Club name provided during signup"
    },
    "branch_count": {
      "type": "string",
      "enum": [
        "1",
        "2-5",
        "6-10",
        "10+"
      ],
      "description": "Number of branches the prospect selected"
    },
    "sport": {
      "type": "string",
      "description": "Primary sport selected during signup"
    },
    "signup_date": {
      "type": "string",
      "format": "date-time",
      "description": "When the trial started"
    },
    "trial_end_date": {
      "type": "string",
      "format": "date-time",
      "description": "When the 14-day trial ends"
    },
    "status": {
      "type": "string",
      "enum": [
        "Trial",
        "Converted",
        "Expired"
      ],
      "default": "Trial",
      "description": "Current trial status"
    },
    "invited_emails": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Emails invited during the optional invite-team step"
    },
    "converted_date": {
      "type": "string",
      "format": "date-time",
      "description": "When the trial converted to paid (if applicable)"
    }
  },
  "required": [
    "email"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {},
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}