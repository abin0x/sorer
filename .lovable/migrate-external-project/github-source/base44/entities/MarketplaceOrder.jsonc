{
  "name": "MarketplaceOrder",
  "type": "object",
  "properties": {
    "club_id": {
      "type": "string",
      "description": "ID of the Club (tenant) this order belongs to"
    },
    "order_number": {
      "type": "string",
      "description": "Human-readable order number (e.g. MKT-2026-0001)"
    },
    "customer_name": {
      "type": "string",
      "description": "Customer full name (collected at checkout)"
    },
    "customer_email": {
      "type": "string",
      "format": "email",
      "description": "Customer email (collected at checkout, used for receipts)"
    },
    "customer_phone": {
      "type": "string",
      "description": "Customer phone number (optional)"
    },
    "user_id": {
      "type": "string",
      "description": "ID of the User record if the customer was signed in. Null for guest checkout."
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "subscription",
              "event",
              "event_series",
              "event_bulk",
              "spiritwear",
              "dues"
            ],
            "description": "What kind of marketplace item this is"
          },
          "reference_id": {
            "type": "string",
            "description": "ID of the source Offer (or legacy SpiritwearProduct/ClubSubscription/ClubEvent)"
          },
          "name": {
            "type": "string",
            "description": "Item display name (denormalized)"
          },
          "variant": {
            "type": "object",
            "description": "For spiritwear: { size, color, sku } of the chosen variant"
          },
          "dates": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "For events: the selected occurrence dates (ISO date strings)"
          },
          "price_option": {
            "type": "object",
            "description": "For events: { key, name, type } of the chosen price option"
          },
          "payment_plan": {
            "type": "string",
            "description": "For dues: 'full', 'monthly', or 'split_guardians'"
          },
          "participant": {
            "type": "object",
            "description": "For events/dues: { name, position, etc. } participant details"
          },
          "player": {
            "type": "object",
            "description": "For dues: { name, roster_id } of the player being paid for"
          },
          "custom_name": {
            "type": "string",
            "description": "For spiritwear: optional custom name printed on item"
          },
          "custom_number": {
            "type": "string",
            "description": "For spiritwear: optional custom number printed on item"
          },
          "fulfillment": {
            "type": "string",
            "enum": [
              "shipping",
              "pickup"
            ],
            "description": "For spiritwear: how the customer wants to receive the item"
          },
          "quantity": {
            "type": "number",
            "default": 1
          },
          "unit_price": {
            "type": "number",
            "description": "Price per unit at time of purchase"
          },
          "line_total": {
            "type": "number",
            "description": "unit_price x quantity (or series/bulk price)"
          },
          "team_id": {
            "type": "string",
            "description": "For dues: ID of the Team this charge is attributed to \u2014 drives the QuickBooks Class on sync"
          },
          "team_name": {
            "type": "string",
            "description": "Team name (denormalized for display)"
          },
          "branch_id": {
            "type": "string",
            "description": "For dues: ID of the Location/branch this charge is attributed to \u2014 drives the QuickBooks Location on sync"
          },
          "branch_name": {
            "type": "string",
            "description": "Branch name (denormalized for display)"
          },
          "season": {
            "type": "string",
            "description": "Season this charge belongs to (e.g. 2026-2027)"
          },
          "charge_type": {
            "type": "string",
            "description": "QuickBooks income account mapping key: dues, event, spiritwear, other"
          }
        }
      },
      "default": [],
      "description": "All line items in this order (denormalized at purchase time)"
    },
    "subtotal": {
      "type": "number",
      "description": "Sum of all line totals"
    },
    "fee_coverage": {
      "type": "number",
      "default": 0,
      "description": "Amount added to cover processing fees (if the customer opted in)"
    },
    "total": {
      "type": "number",
      "description": "Total charged (subtotal + fee_coverage)"
    },
    "currency": {
      "type": "string",
      "default": "USD"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "paid",
        "failed",
        "refunded"
      ],
      "default": "pending",
      "description": "pending = checkout started, paid = payment confirmed by webhook, failed = payment failed, refunded = fully refunded"
    },
    "checkout_mode": {
      "type": "string",
      "enum": [
        "payment",
        "subscription"
      ],
      "default": "payment",
      "description": "Which Stripe Checkout mode was used"
    },
    "stripe_checkout_session_id": {
      "type": "string",
      "description": "Stripe Checkout Session id"
    },
    "stripe_payment_intent_id": {
      "type": "string",
      "description": "Stripe Payment Intent id (from webhook)"
    },
    "stripe_subscription_id": {
      "type": "string",
      "description": "Stripe Subscription id (for recurring subscriptions, from webhook)"
    },
    "fulfillment_status": {
      "type": "string",
      "enum": [
        "unfulfilled",
        "partial",
        "fulfilled"
      ],
      "default": "unfulfilled",
      "description": "For spiritwear: whether items have been delivered/picked up"
    },
    "paid_date": {
      "type": "string",
      "format": "date-time",
      "description": "When payment was confirmed by the webhook"
    },
    "notes": {
      "type": "string",
      "description": "Internal staff notes"
    }
  },
  "required": [
    "club_id",
    "customer_email",
    "items",
    "total",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.club_id": "{{user.data.club_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.customer_email": "{{user.email}}"
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.club_id": "{{user.data.club_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.club_id": "{{user.data.club_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.club_id": "{{user.data.club_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}