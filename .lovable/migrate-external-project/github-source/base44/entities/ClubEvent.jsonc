{
  "name": "ClubEvent",
  "type": "object",
  "properties": {
    "club_id": {
      "type": "string",
      "description": "ID of the Club (tenant) this event belongs to"
    },
    "name": {
      "type": "string",
      "description": "Event name (e.g. 'Summer Skills Camp', 'Tuesday Goalkeeper Clinic')"
    },
    "type": {
      "type": "string",
      "enum": [
        "camp",
        "class",
        "clinic",
        "tournament",
        "open_play",
        "social"
      ],
      "default": "camp",
      "description": "Kind of event \u2014 drives the icon and default capacity"
    },
    "description": {
      "type": "string",
      "description": "Public description shown on the signup page"
    },
    "start_date": {
      "type": "string",
      "format": "date",
      "description": "First day of the event"
    },
    "end_date": {
      "type": "string",
      "format": "date",
      "description": "Last day of the event (same as start_date for single-day)"
    },
    "start_time": {
      "type": "string",
      "description": "Daily start time (e.g. 09:00)"
    },
    "end_time": {
      "type": "string",
      "description": "Daily end time (e.g. 12:00)"
    },
    "location": {
      "type": "string",
      "description": "Field, facility name, or address"
    },
    "location_id": {
      "type": "string",
      "description": "ID of the Location (branch) this event belongs to. Used for branch-filtered analytics."
    },
    "capacity": {
      "type": "number",
      "default": 0,
      "description": "Maximum number of paid registrants. 0 = unlimited."
    },
    "registered_count": {
      "type": "number",
      "default": 0,
      "description": "Number of confirmed (paid or reserved) registrants \u2014 kept in sync as EventRegistration records are created/cancelled"
    },
    "waitlist_count": {
      "type": "number",
      "default": 0,
      "description": "Number of waitlisted registrants"
    },
    "price": {
      "type": "number",
      "default": 0,
      "description": "Cost to register. 0 = free event."
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "open",
        "full",
        "closed",
        "completed",
        "cancelled"
      ],
      "default": "draft",
      "description": "draft = not visible, open = accepting signups, full = at capacity (waitlist only), closed = manually closed, completed = event finished, cancelled = called off"
    },
    "is_public": {
      "type": "boolean",
      "default": true,
      "description": "Whether this event appears on the public event signup page"
    },
    "registration_opens": {
      "type": "string",
      "format": "date",
      "description": "Date registration opens (optional)"
    },
    "registration_closes": {
      "type": "string",
      "format": "date",
      "description": "Date registration closes (optional)"
    },
    "image_url": {
      "type": "string",
      "description": "Optional promotional image URL"
    },
    "allow_waitlist": {
      "type": "boolean",
      "default": true,
      "description": "Whether to accept waitlist signups once the event is full"
    },
    "notes": {
      "type": "string",
      "description": "Internal staff notes (not shown to registrants)"
    },
    "scheduling_event_id": {
      "type": "string",
      "description": "Linked Event containing occurrences, groups, sessions, and recurrence rules"
    },
    "schedule_type": {
      "type": "string",
      "enum": [
        "single",
        "recurring",
        "multi_date"
      ],
      "default": "single"
    },
    "marketplace_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Whether this event appears in the club's public marketplace storefront"
    },
    "series_price": {
      "type": "number",
      "default": 0,
      "description": "Price for a full recurring-series pass. 0 = calculated as price x number of occurrences."
    },
    "bulk_price": {
      "type": "number",
      "default": 0,
      "description": "Price for a full multi-day bulk pass (all days). 0 = calculated as price x number of days."
    }
  },
  "required": [
    "club_id",
    "name",
    "type",
    "start_date"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.club_id": "{{user.data.club_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.club_id": "{{user.data.club_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.club_id": "{{user.data.club_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.club_id": "{{user.data.club_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}