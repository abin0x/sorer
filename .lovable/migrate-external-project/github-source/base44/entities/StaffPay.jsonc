{
  "name": "StaffPay",
  "type": "object",
  "properties": {
    "club_id": {
      "type": "string",
      "description": "ID of the Club (tenant) this staff pay record belongs to. Auto-stamped from the creating user's club_id."
    },
    "unique_id": {
      "type": "string",
      "description": "Unique identifier for the staff pay record (used for imports/updates)"
    },
    "program_id": {
      "type": "string",
      "description": "ID of the associated program"
    },
    "staff_email": {
      "type": "string",
      "description": "Email of staff member being paid (Payee)"
    },
    "staff_name": {
      "type": "string",
      "description": "Staff member name (for display)"
    },
    "payor_email": {
      "type": "string",
      "description": "Email of staff member making the payment (Payor/Assigned Staff)"
    },
    "payor_name": {
      "type": "string",
      "description": "Payor staff member name (for display)"
    },
    "role": {
      "type": "string",
      "description": "Staff role"
    },
    "amount": {
      "type": "number",
      "description": "Payment amount"
    },
    "hours_worked": {
      "type": "number",
      "description": "Hours worked (optional)"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Payment date"
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "to_be_paid",
        "paid"
      ],
      "default": "to_be_paid",
      "description": "Payment status"
    },
    "notes": {
      "type": "string",
      "description": "Additional notes"
    }
  },
  "required": [
    "program_id",
    "staff_email",
    "amount"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.club_id": "{{user.data.club_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.club_id": "{{user.data.club_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.club_id": "{{user.data.club_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.club_id": "{{user.data.club_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}