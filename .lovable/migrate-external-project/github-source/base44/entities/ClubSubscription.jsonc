{
  "name": "ClubSubscription",
  "type": "object",
  "properties": {
    "club_id": {
      "type": "string",
      "description": "ID of the Club (tenant) this subscription belongs to"
    },
    "name": {
      "type": "string",
      "description": "Subscription/membership name (e.g. 'Annual Membership', 'Monthly Booster Club')"
    },
    "description": {
      "type": "string",
      "description": "Public description shown on the marketplace"
    },
    "image_url": {
      "type": "string",
      "description": "Optional image URL"
    },
    "price": {
      "type": "number",
      "description": "Charge amount per billing cycle"
    },
    "billing_interval": {
      "type": "string",
      "enum": [
        "one_time",
        "monthly",
        "yearly"
      ],
      "default": "one_time",
      "description": "one_time = single upfront charge (mode=payment), monthly/yearly = recurring Stripe subscription (mode=subscription)"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "archived"
      ],
      "default": "active",
      "description": "Only active subscriptions appear in the marketplace"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Manual sort order in the marketplace (lower first)"
    }
  },
  "required": [
    "club_id",
    "name",
    "price",
    "billing_interval"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.club_id": "{{user.data.club_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.club_id": "{{user.data.club_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.club_id": "{{user.data.club_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.club_id": "{{user.data.club_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}