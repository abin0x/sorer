{
  "name": "ProgramFeedback",
  "type": "object",
  "properties": {
    "club_id": {
      "type": "string",
      "description": "ID of the Club (tenant) this feedback belongs to. Auto-stamped from the creating user's club_id."
    },
    "program_id": {
      "type": "string",
      "description": "Associated program ID"
    },
    "user_email": {
      "type": "string",
      "description": "Email of the user providing feedback"
    },
    "user_name": {
      "type": "string",
      "description": "Name of the user providing feedback"
    },
    "rating": {
      "type": "number",
      "minimum": 1,
      "maximum": 5,
      "description": "Rating from 1-5 stars"
    },
    "feedback_type": {
      "type": "string",
      "enum": [
        "execution",
        "planning",
        "communication",
        "overall"
      ],
      "description": "Type of feedback"
    },
    "comment": {
      "type": "string",
      "description": "Detailed feedback comment"
    },
    "is_anonymous": {
      "type": "boolean",
      "default": false,
      "description": "Whether feedback is anonymous"
    }
  },
  "required": [
    "program_id",
    "user_email",
    "rating",
    "feedback_type"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.club_id": "{{user.data.club_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.club_id": "{{user.data.club_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.club_id": "{{user.data.club_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.club_id": "{{user.data.club_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}