{
  "name": "Group",
  "type": "object",
  "properties": {
    "club_id": {
      "type": "string",
      "description": "ID of the Club (tenant) this group belongs to"
    },
    "event_id": {
      "type": "string",
      "description": "ID of the Event this group belongs to"
    },
    "name": {
      "type": "string",
      "description": "Group name (e.g. U10 Boys, Advanced)"
    },
    "color": {
      "type": "string",
      "default": "#6366F1",
      "description": "Hex color used to color-code this group throughout the app"
    },
    "metadata": {
      "type": "string",
      "description": "Freeform JSON metadata"
    }
  },
  "required": [
    "club_id",
    "event_id",
    "name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.club_id": "{{user.data.club_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.club_id": "{{user.data.club_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.club_id": "{{user.data.club_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.club_id": "{{user.data.club_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}