{
  "name": "TeamPlan",
  "type": "object",
  "properties": {
    "club_id": {
      "type": "string",
      "description": "ID of the Club (tenant) this team plan belongs to"
    },
    "team_id": {
      "type": "string",
      "description": "ID of the linked Team. Blank for templates or unlinked plans."
    },
    "team_name": {
      "type": "string",
      "description": "Team name (e.g. '2009 Boys Red')"
    },
    "age_group": {
      "type": "string",
      "description": "Age group (e.g. U14, U16)"
    },
    "gender": {
      "type": "string",
      "enum": [
        "Boys",
        "Girls",
        "Boys and Girls"
      ],
      "default": "Boys and Girls",
      "description": "Gender eligibility"
    },
    "playing_format": {
      "type": "string",
      "enum": [
        "4v4",
        "7v7",
        "9v9",
        "11v11"
      ],
      "description": "Playing format"
    },
    "platform_id": {
      "type": "string",
      "description": "ID of the competitive Platform"
    },
    "platform_name": {
      "type": "string",
      "description": "Platform name (denormalized)"
    },
    "branch_id": {
      "type": "string",
      "description": "ID of the Branch (Location) this team belongs to"
    },
    "branch_name": {
      "type": "string",
      "description": "Branch name (denormalized)"
    },
    "season": {
      "type": "string",
      "description": "Season year range (e.g. 2026-2027)"
    },
    "fall_training": {
      "type": "string",
      "description": "Fall training plan description"
    },
    "winter_training": {
      "type": "string",
      "description": "Winter training plan description"
    },
    "spring_training": {
      "type": "string",
      "description": "Spring training plan description"
    },
    "league_games": {
      "type": "string",
      "description": "League games description (league name, game count, etc.)"
    },
    "tournament_count": {
      "type": "number",
      "default": 0,
      "description": "Number of tournaments the team will enter"
    },
    "tournament_names": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Names of the tournaments"
    },
    "included_programs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Programs included in the team plan (e.g. 'Winter Futsal', 'Summer Camp')"
    },
    "club_dues": {
      "type": "number",
      "default": 0,
      "description": "Yearly club dues per player"
    },
    "payment_plans": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "full",
          "monthly",
          "split_guardians"
        ]
      },
      "default": [
        "full",
        "monthly"
      ],
      "description": "Accepted payment plan options for the dues"
    },
    "coach_id": {
      "type": "string",
      "description": "ID of the head coach (Coach entity)"
    },
    "coach_name": {
      "type": "string",
      "description": "Coach name (denormalized)"
    },
    "offer_id": {
      "type": "string",
      "description": "ID of the dues Offer created from this plan in the marketplace"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "archived"
      ],
      "default": "draft",
      "description": "Plan lifecycle status"
    },
    "is_template": {
      "type": "boolean",
      "default": false,
      "description": "True when this plan is a reusable template (not linked to a specific team)"
    },
    "template_name": {
      "type": "string",
      "description": "Template name (when is_template is true)"
    },
    "notes": {
      "type": "string",
      "description": "Internal notes"
    }
  },
  "required": [
    "club_id",
    "team_name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.club_id": "{{user.data.club_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.club_id": "{{user.data.club_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.club_id": "{{user.data.club_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.club_id": "{{user.data.club_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}