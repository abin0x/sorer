{
  "name": "Conflict",
  "type": "object",
  "properties": {
    "club_id": {
      "type": "string"
    },
    "week_start": {
      "type": "string",
      "format": "date"
    },
    "booking_id": {
      "type": "string"
    },
    "other_booking_id": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "no_grid",
        "grid_shared",
        "game_needs_whole_field",
        "overlaps_game",
        "game_team_limit",
        "coach_double",
        "team_double"
      ]
    },
    "severity": {
      "type": "string",
      "enum": [
        "error",
        "warning"
      ]
    },
    "message": {
      "type": "string"
    },
    "conflict_key": {
      "type": "string"
    },
    "resolved": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "club_id",
    "booking_id",
    "type"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.club_id": "{{user.data.club_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.club_id": "{{user.data.club_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.club_id": "{{user.data.club_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.club_id": "{{user.data.club_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}