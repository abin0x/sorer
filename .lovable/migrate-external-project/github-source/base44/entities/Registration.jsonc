{
  "name": "Registration",
  "type": "object",
  "properties": {
    "club_id": {
      "type": "string",
      "description": "ID of the Club (tenant) this registration belongs to"
    },
    "unique_id": {
      "type": "string",
      "description": "Unique identifier for the registration (used for imports/updates)"
    },
    "player_id": {
      "type": "string",
      "description": "ID of the registered player (Player entity)"
    },
    "player_name": {
      "type": "string",
      "description": "Player full name (denormalized for display)"
    },
    "guardian_id": {
      "type": "string",
      "description": "ID of the guardian who registered the player (Guardian entity)"
    },
    "guardian_name": {
      "type": "string",
      "description": "Guardian full name (denormalized for display)"
    },
    "program_id": {
      "type": "string",
      "description": "ID of the program registered for (Program entity)"
    },
    "program_title": {
      "type": "string",
      "description": "Program title (denormalized for display)"
    },
    "location_id": {
      "type": "string",
      "description": "ID of the Location this registration is for"
    },
    "location_name": {
      "type": "string",
      "description": "Location name (denormalized for display)"
    },
    "team_id": {
      "type": "string",
      "description": "ID of the assigned team (Team entity, assigned after approval)"
    },
    "team_name": {
      "type": "string",
      "description": "Assigned team name (denormalized for display)"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected",
        "waitlisted",
        "cancelled"
      ],
      "default": "pending",
      "description": "Registration review status"
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "unpaid",
        "partial",
        "paid",
        "refunded"
      ],
      "default": "unpaid",
      "description": "Payment status for this registration"
    },
    "payment_frequency": {
      "type": "string",
      "enum": [
        "one_time",
        "monthly",
        "quarterly",
        "seasonal"
      ],
      "default": "one_time",
      "description": "How often recurring payments are collected"
    },
    "next_payment_date": {
      "type": "string",
      "format": "date",
      "description": "Next scheduled payment date"
    },
    "next_payment_amount": {
      "type": "number",
      "description": "Amount due on the next payment date"
    },
    "payment_plan_notes": {
      "type": "string",
      "description": "Notes about the payment plan"
    },
    "installment_count": {
      "type": "number",
      "default": 0,
      "description": "Total number of installments in the plan. 0 for one-time payments."
    },
    "installment_amount": {
      "type": "number",
      "default": 0,
      "description": "Amount of each installment"
    },
    "installments_paid": {
      "type": "number",
      "default": 0,
      "description": "Number of installments collected so far"
    },
    "next_installment_date": {
      "type": "string",
      "format": "date",
      "description": "Date the next installment is due (advanced by the daily billing workflow)"
    },
    "autopay_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Whether the guardian opted into autopay \u2014 charges the saved card automatically on each installment due date"
    },
    "stripe_customer_id": {
      "type": "string",
      "description": "Stripe Customer id for this family, created when autopay is set up"
    },
    "autopay_payment_method_id": {
      "type": "string",
      "description": "Stripe PaymentMethod id saved for off-session autopay charges"
    },
    "promo_code": {
      "type": "string",
      "description": "Promo code applied to this registration, if any"
    },
    "discount_amount": {
      "type": "number",
      "default": 0,
      "description": "Discount applied by the promo code"
    },
    "registration_date": {
      "type": "string",
      "format": "date",
      "description": "Date the registration was submitted"
    },
    "amount_due": {
      "type": "number",
      "description": "Total amount due for this registration (after any discount)"
    },
    "amount_paid": {
      "type": "number",
      "default": 0,
      "description": "Amount paid so far"
    },
    "waiver_accepted": {
      "type": "boolean",
      "default": false,
      "description": "Whether the liability waiver was accepted"
    },
    "paperwork_complete": {
      "type": "boolean",
      "default": false,
      "description": "Whether all required paperwork is complete"
    },
    "required_documents": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "List of required documents (e.g. birth certificate, medical form)"
    },
    "completed_documents": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Documents that have been submitted"
    },
    "financial_aid_requested": {
      "type": "boolean",
      "default": false,
      "description": "Whether financial aid was requested"
    },
    "notes": {
      "type": "string",
      "description": "Internal review notes"
    },
    "assigned_to": {
      "type": "string",
      "description": "Email of staff member assigned to review this registration"
    },
    "kanban_task_id": {
      "type": "string",
      "description": "ID of the Kanban Task created for this registration review (links to project management)"
    },
    "offer_id": {
      "type": "string",
      "description": "ID of the Offer this registration was converted from (if applicable)"
    }
  },
  "required": [
    "player_id",
    "guardian_id",
    "program_id",
    "registration_date"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.club_id": "{{user.data.club_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.club_id": "{{user.data.club_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.club_id": "{{user.data.club_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.club_id": "{{user.data.club_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}