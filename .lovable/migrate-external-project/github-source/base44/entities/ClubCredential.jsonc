{
  "name": "ClubCredential",
  "type": "object",
  "properties": {
    "club_id": {
      "type": "string",
      "description": "ID of the Club (tenant) these credentials belong to. One record per club."
    },
    "stripe_secret_key": {
      "type": "string",
      "description": "Club's own Stripe Secret Key (sk_live_... or sk_test_...). Used for payment processing."
    },
    "stripe_publishable_key": {
      "type": "string",
      "description": "Club's own Stripe Publishable Key (optional, for client-side Stripe.js)"
    },
    "stripe_webhook_secret": {
      "type": "string",
      "description": "Signing secret (whsec_...) for the Stripe webhook endpoint configured on this club's own Stripe account, used to verify checkout.session.completed events."
    },
    "stripe_facility_webhook_secret": {
      "type": "string",
      "description": "Signing secret (whsec_...) for the second Stripe endpoint that posts facility-invoice payments to facility-billing-stripe-webhook. Kept separate from stripe_webhook_secret because Stripe issues one secret per endpoint."
    },
    "resend_api_key": {
      "type": "string",
      "description": "Club's own Resend.com API key for custom sending domain setup and email delivery."
    },
    "quickbooks_client_id": {
      "type": "string",
      "description": "Club's own Intuit/QuickBooks OAuth client ID. Falls back to platform env var if empty."
    },
    "quickbooks_client_secret": {
      "type": "string",
      "description": "Club's own Intuit/QuickBooks OAuth client secret. Falls back to platform env var if empty."
    },
    "google_maps_api_key": {
      "type": "string",
      "description": "Club's own Google Maps API key for Distance Matrix travel-time computation in tournament scheduling. Falls back to LLM-based estimation if empty."
    },
    "ayrshare_api_key": {
      "type": "string",
      "description": "Club's own Ayrshare API key. Ayrshare publishes marketing posts to the club's connected Instagram, Facebook, X, LinkedIn and TikTok accounts."
    }
  },
  "required": [
    "club_id"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}