{
  "name": "SeasonArchive",
  "type": "object",
  "properties": {
    "club_id": {
      "type": "string"
    },
    "season_id": {
      "type": "string",
      "description": "The archived season"
    },
    "season_name": {
      "type": "string"
    },
    "next_season_id": {
      "type": "string",
      "description": "The season that became Active at the switch"
    },
    "archived_at": {
      "type": "string",
      "format": "date-time"
    },
    "undo_until": {
      "type": "string",
      "format": "date-time",
      "description": "Admin can reopen the archived season until this time"
    },
    "reopened": {
      "type": "boolean",
      "default": false
    },
    "snapshot": {
      "type": "object",
      "default": {},
      "description": "Counts of teams, rosters, plans, sessions at archive time"
    }
  },
  "required": [
    "club_id",
    "season_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.club_id": "{{user.data.club_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.club_id": "{{user.data.club_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.club_id": "{{user.data.club_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}