{
  "name": "SupportTicket",
  "type": "object",
  "properties": {
    "club_id": {
      "type": "string",
      "description": "ID of the Club (tenant) that submitted this ticket. Auto-stamped from the creating user's club_id."
    },
    "club_name": {
      "type": "string",
      "description": "Club name (denormalized for display in the system console)"
    },
    "subject": {
      "type": "string",
      "description": "Short summary of the issue or request"
    },
    "description": {
      "type": "string",
      "description": "Full details of the issue or request"
    },
    "category": {
      "type": "string",
      "enum": [
        "billing",
        "technical",
        "feature_request",
        "account",
        "other"
      ],
      "default": "other",
      "description": "Ticket category"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "urgent"
      ],
      "default": "medium",
      "description": "Urgency of the ticket"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "in_progress",
        "resolved",
        "closed"
      ],
      "default": "open",
      "description": "Current ticket status"
    },
    "submitted_by_name": {
      "type": "string",
      "description": "Name of the person who submitted the ticket (denormalized)"
    },
    "submitted_by_email": {
      "type": "string",
      "format": "email",
      "description": "Email of the person who submitted the ticket (denormalized)"
    },
    "resolution_notes": {
      "type": "string",
      "description": "Notes from the system owner on how the ticket was resolved"
    },
    "resolved_by": {
      "type": "string",
      "description": "Email of the system user who resolved this ticket"
    },
    "resolved_date": {
      "type": "string",
      "format": "date-time",
      "description": "When the ticket was marked resolved or closed"
    }
  },
  "required": [
    "subject",
    "description"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.club_id": "{{user.data.club_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.club_id": "{{user.data.club_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.club_id": "{{user.data.club_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}