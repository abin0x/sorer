{
  "name": "TournamentRegistration",
  "type": "object",
  "properties": {
    "tournament_id": {
      "type": "string",
      "description": "ID of the Tournament this registration is for"
    },
    "club_id": {
      "type": "string",
      "description": "ID of the organizing Club (denormalized for RLS scoping)"
    },
    "team_name": {
      "type": "string",
      "description": "Registering team name"
    },
    "team_contact_name": {
      "type": "string",
      "description": "Primary contact full name for the registering team"
    },
    "team_contact_email": {
      "type": "string",
      "format": "email",
      "description": "Primary contact email"
    },
    "team_contact_phone": {
      "type": "string",
      "description": "Primary contact phone"
    },
    "coach_name": {
      "type": "string",
      "description": "Head coach name for the registering team (used for coach conflict detection)"
    },
    "team_city": {
      "type": "string",
      "description": "Team home city"
    },
    "team_state": {
      "type": "string",
      "description": "Team home state"
    },
    "age_group": {
      "type": "string",
      "description": "Age group the team is entering (copied from tournament at registration)"
    },
    "gender": {
      "type": "string",
      "enum": [
        "Boys",
        "Girls",
        "Coed"
      ],
      "description": "Gender division"
    },
    "division": {
      "type": "string",
      "description": "Optional division/bracket assignment"
    },
    "roster_count": {
      "type": "number",
      "default": 0,
      "description": "Number of players on the team roster"
    },
    "notes": {
      "type": "string",
      "description": "Optional notes from the registering team"
    },
    "entry_fee": {
      "type": "number",
      "default": 0,
      "description": "Entry fee charged (snapshot at registration time)"
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "pending",
        "paid",
        "refunded",
        "failed"
      ],
      "default": "pending",
      "description": "Stripe payment status"
    },
    "stripe_checkout_session_id": {
      "type": "string",
      "description": "Stripe Checkout Session ID"
    },
    "stripe_payment_intent_id": {
      "type": "string",
      "description": "Stripe Payment Intent ID (set after successful payment)"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "waitlist",
        "rejected"
      ],
      "default": "pending",
      "description": "Organizer approval status"
    },
    "registered_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the registration was submitted"
    }
  },
  "required": [
    "tournament_id",
    "club_id",
    "team_name",
    "team_contact_email",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.club_id": "{{user.data.club_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "system_role": "system_owner"
          }
        },
        {
          "user_condition": {
            "system_role": "system_admin"
          }
        }
      ]
    },
    "create": {},
    "update": {
      "$or": [
        {
          "data.club_id": "{{user.data.club_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "system_role": "system_owner"
          }
        },
        {
          "user_condition": {
            "system_role": "system_admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.club_id": "{{user.data.club_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "system_role": "system_owner"
          }
        }
      ]
    }
  }
}