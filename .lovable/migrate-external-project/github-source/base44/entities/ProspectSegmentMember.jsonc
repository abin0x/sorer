{
  "name": "ProspectSegmentMember",
  "type": "object",
  "properties": {
    "prospect_id": {
      "type": "string",
      "description": "FK \u2192 Prospect"
    },
    "prospect_name": {
      "type": "string",
      "description": "Prospect full name (denormalized)"
    },
    "prospect_email": {
      "type": "string",
      "description": "Prospect email (denormalized)"
    },
    "segment_id": {
      "type": "string",
      "description": "FK \u2192 ProspectSegment"
    },
    "segment_name": {
      "type": "string",
      "description": "Segment name (denormalized)"
    },
    "added_by": {
      "type": "string",
      "enum": [
        "manual",
        "rule",
        "webhook"
      ],
      "default": "manual",
      "description": "How the prospect was added to this segment"
    }
  },
  "required": [
    "prospect_id",
    "segment_id"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "system_role": "system_owner"
      }
    },
    "create": {
      "user_condition": {
        "system_role": "system_owner"
      }
    },
    "update": {
      "user_condition": {
        "system_role": "system_owner"
      }
    },
    "delete": {
      "user_condition": {
        "system_role": "system_owner"
      }
    }
  }
}