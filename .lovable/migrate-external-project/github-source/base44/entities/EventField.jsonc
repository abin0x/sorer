{
  "name": "EventField",
  "type": "object",
  "properties": {
    "club_id": {
      "type": "string",
      "description": "ID of the Club (tenant) this field belongs to"
    },
    "location_id": {
      "type": "string",
      "description": "ID of the parent EventLocation"
    },
    "name": {
      "type": "string",
      "description": "Field name (e.g. Field 1, Court A)"
    },
    "capacity": {
      "type": "number",
      "default": 0,
      "description": "Maximum capacity for this field"
    },
    "status": {
      "type": "string",
      "enum": [
        "available",
        "maintenance"
      ],
      "default": "available",
      "description": "Whether this field can be booked for sessions"
    },
    "attributes": {
      "type": "string",
      "description": "Freeform JSON attributes (surface, indoor/outdoor, etc.)"
    }
  },
  "required": [
    "club_id",
    "location_id",
    "name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.club_id": "{{user.data.club_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.club_id": "{{user.data.club_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.club_id": "{{user.data.club_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.club_id": "{{user.data.club_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}