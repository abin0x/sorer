{
  "name": "League",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "League name (e.g. MSPRL, NPL, ECNL)"
    },
    "notes": {
      "type": "string",
      "description": "Internal notes about this league"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether this league is currently offered"
    }
  },
  "required": [
    "name"
  ]
}