{
  "name": "InvoiceLineItem",
  "type": "object",
  "properties": {
    "club_id": {
      "type": "string"
    },
    "invoice_id": {
      "type": "string",
      "description": "Invoice this line belongs to"
    },
    "billing_entity_id": {
      "type": "string",
      "description": "Denormalized from the invoice so portal access can be scoped on the line itself"
    },
    "booking_id": {
      "type": "string",
      "description": "Booking that produced this line"
    },
    "description": {
      "type": "string",
      "description": "What is being billed, e.g. Field rental \u2014 training"
    },
    "details": {
      "type": "string",
      "description": "Who the booking was for, e.g. U12 Girls vs Northville United"
    },
    "booking_date": {
      "type": "string",
      "format": "date"
    },
    "field_name": {
      "type": "string"
    },
    "facility_name": {
      "type": "string"
    },
    "start_time": {
      "type": "string",
      "description": "Display start time, e.g. 6:30 PM"
    },
    "end_time": {
      "type": "string"
    },
    "hours": {
      "type": "number",
      "default": 0
    },
    "unit_rate": {
      "type": "number",
      "default": 0,
      "description": "Hourly rate applied"
    },
    "amount": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "club_id",
    "invoice_id",
    "billing_entity_id",
    "amount"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.billing_entity_id": "{{user.data.billing_entity_id}}"
        },
        {
          "data.club_id": "{{user.data.club_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.club_id": "{{user.data.club_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.club_id": "{{user.data.club_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.club_id": "{{user.data.club_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}