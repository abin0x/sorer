{
  "name": "AppConfig",
  "type": "object",
  "properties": {
    "club_id": {
      "type": "string",
      "description": "Club (tenant) this config belongs to. Null/absent for system-level configs (e.g. system_theme)."
    },
    "config_key": {
      "type": "string",
      "description": "Configuration key (e.g., 'available_branches', 'system_theme', 'theme_settings')"
    },
    "config_value": {
      "type": "object",
      "description": "Configuration value as JSON object"
    }
  },
  "required": [
    "config_key",
    "config_value"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.club_id": "{{user.data.club_id}}"
        },
        {
          "data.club_id": {
            "$exists": false
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "system_role": "system_owner"
          }
        },
        {
          "user_condition": {
            "system_role": "system_admin"
          }
        },
        {
          "user_condition": {
            "system_role": "system_support"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.club_id": "{{user.data.club_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "system_role": "system_owner"
          }
        },
        {
          "user_condition": {
            "system_role": "system_admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.club_id": "{{user.data.club_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "system_role": "system_owner"
          }
        },
        {
          "user_condition": {
            "system_role": "system_admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.club_id": "{{user.data.club_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "system_role": "system_owner"
          }
        },
        {
          "user_condition": {
            "system_role": "system_admin"
          }
        }
      ]
    }
  }
}