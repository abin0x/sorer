{
  "name": "KBFeedback",
  "type": "object",
  "properties": {
    "article_id": {
      "type": "string"
    },
    "article_slug": {
      "type": "string"
    },
    "article_title": {
      "type": "string"
    },
    "helpful": {
      "type": "boolean"
    },
    "comment": {
      "type": "string"
    },
    "club_id": {
      "type": "string"
    },
    "role": {
      "type": "string"
    }
  },
  "required": [
    "article_slug",
    "helpful"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "system_role": "system_owner"
          }
        },
        {
          "user_condition": {
            "system_role": "system_admin"
          }
        },
        {
          "user_condition": {
            "system_role": "system_support"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "system_role": "system_owner"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "system_role": "system_owner"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "system_role": "system_owner"
          }
        }
      ]
    }
  }
}