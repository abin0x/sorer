{
  "name": "ChatMessage",
  "type": "object",
  "properties": {
    "club_id": {
      "type": "string",
      "description": "ID of the Club (tenant) this chat message belongs to. Auto-stamped from the creating user's club_id."
    },
    "program_id": {
      "type": "string",
      "description": "Associated program ID"
    },
    "sender_email": {
      "type": "string",
      "description": "Email of message sender"
    },
    "sender_name": {
      "type": "string",
      "description": "Name of message sender"
    },
    "message": {
      "type": "string",
      "description": "Chat message content"
    },
    "message_type": {
      "type": "string",
      "enum": [
        "text",
        "file",
        "system"
      ],
      "default": "text",
      "description": "Type of message"
    },
    "file_url": {
      "type": "string",
      "description": "URL if message contains a file"
    },
    "file_name": {
      "type": "string",
      "description": "File name if message contains a file"
    },
    "mentioned_users": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Emails of mentioned users"
    },
    "reply_to": {
      "type": "string",
      "description": "ID of message being replied to"
    },
    "edited": {
      "type": "boolean",
      "default": false,
      "description": "Whether message was edited"
    },
    "read_by": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Emails of users who read the message"
    }
  },
  "required": [
    "program_id",
    "sender_email",
    "message"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.club_id": "{{user.data.club_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.club_id": "{{user.data.club_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.club_id": "{{user.data.club_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.club_id": "{{user.data.club_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}