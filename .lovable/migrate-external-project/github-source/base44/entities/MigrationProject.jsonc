{
  "name": "MigrationProject",
  "type": "object",
  "properties": {
    "club_id": {
      "type": "string",
      "description": "Owning club. Set by the server, never read from a CSV."
    },
    "name": {
      "type": "string",
      "description": "Project name"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "files_uploaded",
        "analyzed",
        "mapping_review",
        "staged",
        "specialist_review",
        "approved",
        "committing",
        "live",
        "failed",
        "rolled_back"
      ],
      "default": "draft"
    },
    "source_system": {
      "type": "string",
      "description": "Platform the data is coming from (teamsnap, sportsengine, ...)"
    },
    "season": {
      "type": "string",
      "description": "Project constant: season stamped on imported records, never read from the CSV"
    },
    "assigned_specialist": {
      "type": "string",
      "description": "Club Rudder migration specialist (email)"
    },
    "second_person_approval": {
      "type": "boolean",
      "default": false
    },
    "approvals": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "properties": {
          "by": {
            "type": "string"
          },
          "at": {
            "type": "string"
          }
        }
      },
      "description": "Sign-offs recorded by specialists"
    },
    "questions": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "asked_by": {
            "type": "string"
          },
          "asked_at": {
            "type": "string"
          },
          "answer": {
            "type": "string"
          },
          "answered_by": {
            "type": "string"
          },
          "answered_at": {
            "type": "string"
          }
        }
      },
      "description": "Plain-language questions from the specialist to the club admin"
    },
    "stage_summary": {
      "type": "object",
      "default": {},
      "description": "Counts from the latest staging run"
    },
    "commit_summary": {
      "type": "object",
      "default": {},
      "description": "Progress / result of the latest commit"
    },
    "failure_reason": {
      "type": "string"
    },
    "committed_at": {
      "type": "string",
      "format": "date-time"
    },
    "rollback_window_days": {
      "type": "number",
      "default": 14
    },
    "created_by_user_id": {
      "type": "string"
    },
    "created_by_name": {
      "type": "string"
    },
    "history": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "by": {
            "type": "string"
          },
          "at": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        }
      },
      "description": "Every status transition with who and when"
    }
  },
  "required": [
    "club_id",
    "name",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.club_id": "{{user.data.club_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}