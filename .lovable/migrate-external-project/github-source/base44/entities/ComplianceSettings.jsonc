{
  "name": "ComplianceSettings",
  "type": "object",
  "properties": {
    "club_id": {
      "type": "string",
      "description": "Club (tenant) these settings belong to"
    },
    "governing_bodies": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "us_soccer",
          "girls_academy_league",
          "mls_next",
          "gotsports",
          "us_youth_soccer",
          "us_club_soccer",
          "michigan_youth_soccer"
        ]
      },
      "default": [],
      "description": "Governing bodies the club is affiliated with"
    },
    "ankored_url": {
      "type": "string",
      "description": "Link to the club's Ankored compliance portal (MLS Next)"
    }
  },
  "required": [
    "club_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.club_id": "{{user.data.club_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}