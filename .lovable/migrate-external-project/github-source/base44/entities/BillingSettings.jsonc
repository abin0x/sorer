{
  "name": "BillingSettings",
  "type": "object",
  "properties": {
    "grace_period_days": {
      "type": "number",
      "default": 7,
      "description": "Days a module stays past_due (with access) before being suspended"
    },
    "trial_period_days": {
      "type": "number",
      "default": 14,
      "description": "Default trial length in days for new module subscriptions"
    },
    "alert_email": {
      "type": "string",
      "format": "email",
      "description": "Email address to receive drift and billing alerts from nightly reconciliation"
    },
    "reconcile_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Whether the nightly Stripe reconciliation is active"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether this settings row is the active configuration"
    }
  },
  "required": [],
  "rls": {
    "read": {},
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "system_role": "system_owner"
          }
        },
        {
          "user_condition": {
            "system_role": "system_admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "system_role": "system_owner"
          }
        },
        {
          "user_condition": {
            "system_role": "system_admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "system_role": "system_owner"
          }
        }
      ]
    }
  }
}