{
  "name": "PlatformAccess",
  "type": "object",
  "properties": {
    "club_id": {
      "type": "string",
      "description": "ID of the Club (tenant) this access grant belongs to. Auto-stamped from the creating user's club_id."
    },
    "user_id": {
      "type": "string",
      "description": "ID of the user granted access to this platform dashboard"
    },
    "user_email": {
      "type": "string",
      "description": "User email (denormalized for display)"
    },
    "user_name": {
      "type": "string",
      "description": "User full name (denormalized for display)"
    },
    "user_role": {
      "type": "string",
      "description": "User's custom role (denormalized)"
    },
    "platform_id": {
      "type": "string",
      "description": "ID of the Platform this user has access to"
    },
    "platform_name": {
      "type": "string",
      "description": "Platform name (denormalized for display)"
    },
    "granted_by": {
      "type": "string",
      "description": "Email of the admin who granted access"
    },
    "granted_date": {
      "type": "string",
      "format": "date-time",
      "description": "When access was granted"
    }
  },
  "required": [
    "user_id",
    "platform_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.club_id": "{{user.data.club_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.club_id": "{{user.data.club_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.club_id": "{{user.data.club_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.club_id": "{{user.data.club_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}