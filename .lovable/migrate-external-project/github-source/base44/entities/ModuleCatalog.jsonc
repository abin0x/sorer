{
  "name": "ModuleCatalog",
  "type": "object",
  "properties": {
    "key": {
      "type": "string",
      "description": "Unique module key (e.g. player_development, facility_management, kanban)"
    },
    "name": {
      "type": "string",
      "description": "Display name shown to tenants"
    },
    "description": {
      "type": "string",
      "description": "Short description of what the module provides"
    },
    "icon": {
      "type": "string",
      "description": "Lucide-react icon name for display"
    },
    "category": {
      "type": "string",
      "description": "Grouping category (e.g. Operations, Development, Finance)"
    },
    "stripe_price_id": {
      "type": "string",
      "description": "Stripe Price ID for this module's monthly subscription. Null for complimentary-only modules."
    },
    "price_monthly": {
      "type": "number",
      "description": "Monthly price in major currency units (for display only; Stripe Price is authoritative)"
    },
    "currency": {
      "type": "string",
      "default": "USD",
      "description": "ISO currency code"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether this module is available for purchase/activation"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Display order in the catalog"
    },
    "features": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Feature list shown on the locked-module gate screen"
    },
    "nav_items": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Sidebar navigation item titles controlled by this module"
    },
    "route_paths": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "App routes gated by this module (e.g. /PlayerRoster, /Facilities)"
    }
  },
  "required": [
    "key",
    "name",
    "is_active"
  ],
  "rls": {
    "read": {},
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "system_role": "system_owner"
          }
        },
        {
          "user_condition": {
            "system_role": "system_admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "system_role": "system_owner"
          }
        },
        {
          "user_condition": {
            "system_role": "system_admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "system_role": "system_owner"
          }
        }
      ]
    }
  }
}