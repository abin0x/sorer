{
  "name": "NotificationPreference",
  "type": "object",
  "properties": {
    "club_id": {
      "type": "string",
      "description": "ID of the Club (tenant) this preference row belongs to"
    },
    "user_id": {
      "type": "string",
      "description": "ID of the User these preferences belong to (one record per user)"
    },
    "user_email": {
      "type": "string",
      "description": "User email (denormalized \u2014 used to resolve notifications quickly)"
    },
    "preset": {
      "type": "string",
      "enum": [
        "essentials",
        "balanced",
        "everything"
      ],
      "default": "balanced",
      "description": "Essentials only, Balanced (default), or Everything"
    },
    "channel_overrides": {
      "type": "object",
      "default": {},
      "description": "Map of channel_id -> 'push' | 'badge' | 'digest' | 'off', overriding the preset for that channel"
    },
    "mention_push": {
      "type": "boolean",
      "default": true,
      "description": "Always push for @mentions and replies to my thread, regardless of channel setting"
    },
    "digest_time": {
      "type": "string",
      "default": "08:00",
      "description": "Hour (HH:mm, 24h) the daily digest summary is delivered"
    },
    "quiet_hours": {
      "type": "object",
      "default": {
        "enabled": false,
        "weekday_start": "21:00",
        "weekday_end": "07:00",
        "weekend_start": "22:00",
        "weekend_end": "08:00",
        "timezone": "America/New_York",
        "priority_override": true,
        "schedule_override": true
      },
      "description": "Per-user quiet hours window with separate weekday/weekend schedules, timezone, and whether priority or imminent schedule changes break through"
    },
    "mutes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "scope": {
            "type": "string",
            "enum": [
              "channel",
              "team"
            ]
          },
          "target_id": {
            "type": "string"
          },
          "target_name": {
            "type": "string"
          },
          "level": {
            "type": "string",
            "enum": [
              "all",
              "mentions",
              "muted"
            ]
          },
          "expires_at": {
            "type": "string"
          }
        }
      },
      "default": [],
      "description": "Mutes per channel or per team. expires_at blank/null means 'until I change it'."
    }
  },
  "required": [
    "user_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "data.club_id": "{{user.data.club_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}