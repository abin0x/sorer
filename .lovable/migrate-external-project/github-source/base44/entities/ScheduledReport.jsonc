{
  "name": "ScheduledReport",
  "type": "object",
  "properties": {
    "club_id": {
      "type": "string",
      "description": "ID of the Club (tenant) this scheduled report belongs to. Auto-stamped from the creating user's club_id."
    },
    "name": {
      "type": "string",
      "description": "Report name"
    },
    "frequency": {
      "type": "string",
      "enum": [
        "daily",
        "weekly",
        "monthly"
      ],
      "description": "How often the report is sent"
    },
    "recipients": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of email addresses to receive the report"
    },
    "include_programs": {
      "type": "boolean",
      "default": true,
      "description": "Include programs summary"
    },
    "include_tasks": {
      "type": "boolean",
      "default": true,
      "description": "Include tasks status"
    },
    "include_expenses": {
      "type": "boolean",
      "default": true,
      "description": "Include expenses and approvals"
    },
    "include_budget": {
      "type": "boolean",
      "default": true,
      "description": "Include budget analysis"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether this report is active"
    },
    "last_sent": {
      "type": "string",
      "format": "date-time",
      "description": "Last time the report was sent"
    }
  },
  "required": [
    "name",
    "frequency",
    "recipients"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.club_id": "{{user.data.club_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.club_id": "{{user.data.club_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.club_id": "{{user.data.club_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.club_id": "{{user.data.club_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}