{
  "name": "TimeEntry",
  "type": "object",
  "properties": {
    "club_id": {
      "type": "string",
      "description": "ID of the Club (tenant) this time entry belongs to. Auto-stamped from the creating user's club_id."
    },
    "program_id": {
      "type": "string",
      "description": "Associated program ID"
    },
    "task_id": {
      "type": "string",
      "description": "Associated task ID (optional)"
    },
    "user_email": {
      "type": "string",
      "description": "User who logged the time"
    },
    "user_name": {
      "type": "string",
      "description": "User's display name"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Date of work"
    },
    "hours": {
      "type": "number",
      "description": "Hours worked"
    },
    "description": {
      "type": "string",
      "description": "Description of work done"
    },
    "billable": {
      "type": "boolean",
      "default": true,
      "description": "Whether time is billable"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "submitted",
        "approved",
        "rejected"
      ],
      "default": "submitted",
      "description": "Time entry status"
    },
    "approved_by": {
      "type": "string",
      "description": "Email of approver"
    },
    "approval_date": {
      "type": "string",
      "format": "date",
      "description": "Date approved/rejected"
    }
  },
  "required": [
    "program_id",
    "user_email",
    "date",
    "hours"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.club_id": "{{user.data.club_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.club_id": "{{user.data.club_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.club_id": "{{user.data.club_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.club_id": "{{user.data.club_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}