{
  "name": "PostTemplate",
  "type": "object",
  "properties": {
    "club_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "tryout",
        "tournament",
        "match",
        "registration",
        "fundraiser",
        "custom"
      ],
      "default": "custom"
    },
    "platform": {
      "type": "string",
      "default": "any",
      "description": "A platform key or 'any'"
    },
    "tone": {
      "type": "string",
      "enum": [
        "hype",
        "informative",
        "friendly",
        "professional"
      ],
      "default": "friendly"
    },
    "body_template": {
      "type": "string",
      "description": "Text with {merge_tags}: club_name, event_name, team_name, age_group, date, time, location, link"
    },
    "hashtags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "image_prompt_template": {
      "type": "string"
    },
    "is_system": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "club_id",
    "name",
    "body_template"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.club_id": "{{user.data.club_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.club_id": "{{user.data.club_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.club_id": "{{user.data.club_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.club_id": "{{user.data.club_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}