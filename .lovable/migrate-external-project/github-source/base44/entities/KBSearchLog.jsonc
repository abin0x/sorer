{
  "name": "KBSearchLog",
  "type": "object",
  "properties": {
    "query": {
      "type": "string",
      "description": "Lowercased search text"
    },
    "results_count": {
      "type": "number",
      "default": 0
    },
    "clicked_article_slug": {
      "type": "string"
    },
    "club_id": {
      "type": "string"
    },
    "role": {
      "type": "string"
    }
  },
  "required": [
    "query"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "system_role": "system_owner"
          }
        },
        {
          "user_condition": {
            "system_role": "system_admin"
          }
        },
        {
          "user_condition": {
            "system_role": "system_support"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "system_role": "system_owner"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "system_role": "system_owner"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "system_role": "system_owner"
          }
        }
      ]
    }
  }
}