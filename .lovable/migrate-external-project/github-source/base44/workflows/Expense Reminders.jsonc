  "description": "Daily at 9am: reminds approvers about reports stuck in review past the reminder threshold, and escalates to the club director past the escalation threshold.",
  "name": "Expense Reminders",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "expense_reminders",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "remind": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "expense-reminders",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Send reminders & escalations",
