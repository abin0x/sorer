{
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "demo_request_journey_sync",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "sync_journey": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "sync-client-journey",
            "args": {
              "type": "demo",
              "email": "${ .trigger.data.email }",
              "name": "${ .trigger.data.name }",
              "club_name": "${ .trigger.data.club_name }",
              "branch_count": "${ .trigger.data.branch_count }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Sync to status sheet",
            "description": "Upsert ClientJourney and send confirmation"
          }
        }
      }
    ]
  },
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "DemoAccessRequest"
    }
  },
  "name": "Demo Request Journey Sync",
  "description": "Creates or updates the status-sheet record and sends a confirmation email when someone requests a demo"
}