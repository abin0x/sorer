{
  "name": "Tryout Reminders",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 9 * * *",
      "one_time_date": null,
      "timezone": "America/New_York",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "description": "Daily at 9am: reminds registered families about tryout sessions happening tomorrow.",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "tryout_reminders",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "send_reminders": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "tryoutReminders",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Remind families",
            "description": "Sessions happening tomorrow"
          }
        }
      }
    ]
  }
}