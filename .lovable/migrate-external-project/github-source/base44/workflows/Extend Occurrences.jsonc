  "description": "Every night at 3am, re-expands all published recurring events to keep a rolling 90-day window of future occurrences generated.",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "extend_occurrences",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "extend": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "extend-occurrences",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Extend occurrence window",
